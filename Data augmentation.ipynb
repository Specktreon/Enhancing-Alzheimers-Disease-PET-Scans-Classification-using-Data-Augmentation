   "source": [
    "import os\n",
    "import numpy as np\n",
    "import pydicom\n",
    "import tensorflow as tf\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import Dense, Reshape, Flatten, LeakyReLU\n",
    "from tensorflow.keras.optimizers import Adam\n",
    "from tensorflow.keras.callbacks import ModelCheckpoint\n",
    "\n",
    "# Define constants\n",
    "DATA_DIR = r'C:\\Users\\ASUS\\OneDrive\\Bureau\\AD'\n",
    "IMAGE_SHAPE = (160, 160)\n",
    "LATENT_DIM = 100\n",
    "BATCH_SIZE = 1024\n",
    "EPOCHS = 100\n",
    "CHECKPOINT_DIR = r'C:\\Users\\ASUS\\OneDrive\\Bureau\\model_checkpoints'\n",
    "\n",
    "# Ensure the checkpoint directory exists\n",
    "os.makedirs(CHECKPOINT_DIR, exist_ok=True)\n",
    "\n",
    "# ModelCheckpoint with save_freq\n",
    "checkpoint_callback = ModelCheckpoint(\n",
    "    filepath=os.path.join(CHECKPOINT_DIR, 'gan_epoch_{epoch:04d}.ckpt'),\n",
    "    save_weights_only=True,\n",
    "    save_freq='epoch',  # Save every epoch, can be set to an integer for batch frequency\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "\n",
    "with tf.device('/GPU:0'):\n",
    "    # Function to load data in batches\n",
    "    def load_data_batch(data_dir, batch_size, target_shape=(160, 160)):\n",
    "        for patient_dir in os.listdir(data_dir):\n",
    "            patient_data = []\n",
    "            for filename in os.listdir(os.path.join(data_dir, patient_dir)):\n",
    "                if filename.endswith(\".dcm\"):\n",
    "                    dcm_path = os.path.join(data_dir, patient_dir, filename)\n",
    "                    dcm = pydicom.dcmread(dcm_path)\n",
    "                    img = dcm.pixel_array\n",
    "                    img = np.clip((img - np.min(img)) / (np.max(img) - np.min(img) + 1e-5), 0, 1)\n",
    "                    img = np.resize(img, target_shape)\n",
    "                    patient_data.append(img)\n",
    "                    if len(patient_data) == batch_size:\n",
    "                        yield np.array(patient_data)\n",
    "                        patient_data = []\n",
    "            if patient_data:\n",
    "                yield np.array(patient_data)\n",
    "\n",
    "    # Generator model\n",
    "    def build_generator(latent_dim):\n",
    "        model = Sequential([\n",
    "            Dense(128, input_dim=latent_dim),\n",
    "            LeakyReLU(alpha=0.2),\n",
    "            Dense(np.prod(IMAGE_SHAPE), activation='sigmoid'),\n",
    "            Reshape(IMAGE_SHAPE)\n",
    "        ])\n",
    "        return model\n",
    "\n",
    "    # Discriminator model\n",
    "    def build_discriminator(input_shape):\n",
    "        model = Sequential([\n",
    "            Flatten(input_shape=input_shape),\n",
    "            Dense(128),\n",
    "            LeakyReLU(alpha=0.2),\n",
    "            Dense(1, activation='sigmoid')\n",
    "        ])\n",
    "        return model\n",
    "\n",
    "        # Build and compile the discriminator\n",
    "    discriminator = build_discriminator(IMAGE_SHAPE)\n",
    "    discriminator.compile(loss='binary_crossentropy', optimizer=Adam(learning_rate=0.0002, beta_1=0.5), metrics=['accuracy'])\n",
    "\n",
    "    # Build the generator\n",
    "    generator = build_generator(LATENT_DIM)\n",
    "\n",
    "    # Combined GAN model\n",
    "    gan = Sequential([generator, discriminator])\n",
    "    discriminator.trainable = False  # Freeze the discriminator during GAN training\n",
    "    gan.compile(loss='binary_crossentropy', optimizer=Adam(learning_rate=0.0002, beta_1=0.5))\n",
    "\n",
    "    \n",
    "    # Training loop\n",
    "    for epoch in range(EPOCHS):\n",
    "        print(f\"Epoch: {epoch+1}/{EPOCHS}\")\n",
    "        batch_count = 0  \n",
    "        for batch_data in load_data_batch(DATA_DIR, BATCH_SIZE, IMAGE_SHAPE):\n",
    "            batch_count += 1\n",
    "            # Generate random noise vectors for the generator\n",
    "            noise = np.random.normal(0, 1, (batch_data.shape[0], LATENT_DIM))\n",
    "            generated_images = generator.predict(noise)\n",
    "\n",
    "            \n",
    "            X = np.concatenate([batch_data, generated_images])\n",
    "            y_dis = np.zeros(2 * batch_data.shape[0])\n",
    "            y_dis[:batch_data.shape[0]] = 0.9  \n",
    "\n",
    "            # Train the discriminator\n",
    "            discriminator.trainable = True\n",
    "            d_loss = discriminator.train_on_batch(X, y_dis)\n",
    "\n",
    "            # Train the generator (via the combined model)\n",
    "            noise = np.random.normal(0, 1, (BATCH_SIZE, LATENT_DIM))\n",
    "            y_gen = np.ones(BATCH_SIZE)\n",
    "            discriminator.trainable = False\n",
    "            g_loss = gan.train_on_batch(noise, y_gen)\n",
    "\n",
    "            if batch_count % 10 == 0:  \n",
    "                print(f\"Epoch: {epoch+1}, Batch: {batch_count}, Discriminator Loss: {d_loss}, Generator Loss: {g_loss}\")\n",
    "\n",
    "        \n",
    "        print(f\"Epoch: {epoch+1} completed, Discriminator Loss: {d_loss}, Generator Loss: {g_loss}\")\n",
    "        if (epoch + 1) % 5 == 0:\n",
    "            generator.save_weights(os.path.join(CHECKPOINT_DIR, f'generator_epoch_{epoch+1}.h5'))\n",
    "            discriminator.save_weights(os.path.join(CHECKPOINT_DIR, f'discriminator_epoch_{epoch+1}.h5'))\n",
    "            print(f\"Checkpoint saved at epoch {epoch+1}\")\n",
    "\n",
    "    # Function to generate and save DICOM images\n",
    "    def generate_dicom_images(generator, latent_dim, num_images=5, output_dir='generated_dicom'):\n",
    "        if not os.path.exists(output_dir):\n",
    "            os.makedirs(output_dir)\n",
    "        for i in range(num_images):\n",
    "            noise = np.random.normal(0, 1, (1, latent_dim))\n",
    "            generated_image = generator.predict(noise)[0]\n",
    "            pixel_min = np.min(generated_image)\n",
    "            pixel_max = np.max(generated_image)\n",
    "            generated_image = (generated_image - pixel_min) * 255 / (pixel_max - pixel_min)\n",
    "            ds = pydicom.dataset.Dataset()\n",
    "            ds.PatientName = \"Generated Patient\"\n",
    "            ds.PatientID = str(i)\n",
    "            ds.StudyInstanceUID = generate_uid()\n",
    "            ds.SeriesInstanceUID = generate_uid()\n",
    "            ds.SOPInstanceUID = generate_uid()\n",
    "            ds.Rows = IMAGE_SHAPE[0]\n",
    "            ds.Columns = IMAGE_SHAPE[1]\n",
    "            ds.PhotometricInterpretation = 'MONOCHROME2'\n",
    "            ds.PixelRepresentation = 0\n",
    "            ds.BitsStored = 8\n",
    "            ds.BitsAllocated = 8\n",
    "            ds.HighBit = 7\n",
    "            ds.SamplesPerPixel = 1\n",
    "            ds.PixelData = generated_image.astype(np.uint8).tobytes()\n",
    "            ds.is_little_endian = True\n",
    "            ds.is_implicit_VR = True\n",
    "            output_file = os.path.join(output_dir, f\"generated_image_{i}.dcm\")\n",
    "            ds.save_as(output_file)\n",
    "            print(f\"Generated DICOM image {i+1}/{num_images}: {output_file}\")\n",
    "\n",
    "    # Generate and save DICOM images\n",
    "    generate_dicom_images(generator, LATENT_DIM, num_images=1000, output_dir=r'C:\\Users\\ASUS\\OneDrive\\Bureau\\dcm results')"
   ]
